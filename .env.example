# =========================================================
# 项目环境变量模板
# 注意：
# 1. 这个文件可以提交到 GitHub
# 2. 真正的 .env 不要提交
# 3. 新服务器部署时，setup.sh 会自动复制本文件为 .env
# =========================================================

APP_ENV=production
APP_PORT=3000

# 数据库配置示例
DB_HOST=db
DB_PORT=5432
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=change_me

# Redis 示例
REDIS_HOST=redis
REDIS_PORT=6379

# 域名配置
DOMAIN=example.com

# 时区
TZ=Asia/Shanghai
